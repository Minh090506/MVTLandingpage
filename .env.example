# Copy to .env and fill in. .env is gitignored — never commit real values.
# Supabase project: vivatour-db (ref tnwelgvypmhhksqwnfmr)
# These are pushed to both Cloudflare Workers via:
#   printf "%s" "$SUPABASE_SERVICE_KEY" | npx wrangler secret put SUPABASE_SERVICE_KEY
#   printf "%s" "$SUPABASE_SERVICE_KEY" | npx wrangler secret put SUPABASE_SERVICE_KEY -c wrangler-dental.toml

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role JWT — bypasses RLS, never expose client-side>
